# ==========================================
# Временные файлы сборки Yocto (BitBake)
# ==========================================
# Игнорируем всю тяжелую папку временных артефактов и кросс-компиляции
**/tmp*/

# Кэш состояния сборки (sstate-cache) и папка скачанных исходников (downloads)
**/sstate-cache/
**/downloads/

# Локальные логи BitBake и истории сборки
**/buildhistory/
../build-*/
**/cache/

# Псевдо-рут база данных (утилита pseudo)
**/pseudo/

# Файлы блокировки и сокеты PR-сервера
**/*.lock
**/prserv.sqlite3

# ==========================================
# Конфигурационные файлы (Локальные для хоста)
# ==========================================
# По стандарту Yocto local.conf и bblayers.conf настраиваются индивидуально.
# Но так как вы зафиксировали настройки Qt внутри проекта, local.conf мы оставляем, 
# а его резервные копии и логи игнорируем:
**/conf/local.conf.sample
**/conf/bblayers.conf.sample

# Игнорируем автоматически сгенерированные файлы среды
**/conf/sanity_info
**/conf/templateconf.cfg

# ==========================================
# Временные файлы репозитория Google repo
# ==========================================
.repo/
**/git-repo/

# ==========================================
# Системные файлы операционной системы и сред
# ==========================================
.DS_Store
Thmubs.db
*~
*.swp
*.bak
TRACE_FILE

